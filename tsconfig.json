{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@core/*": ["src/core/*"],
      "@input/*": ["src/input/*"],
      "@player/*": ["src/player/*"],
      "@weapons/*": ["src/weapons/*"],
      "@enemies/*": ["src/enemies/*"],
      "@world/*": ["src/world/*"],
      "@traversal/*": ["src/traversal/*"],
      "@quests/*": ["src/quests/*"],
      "@dialogue/*": ["src/dialogue/*"],
      "@ui/*": ["src/ui/*"],
      "@audio/*": ["src/audio/*"],
      "@data/*": ["src/data/*"],
      "@utils/*": ["src/utils/*"]
    }
  },
  "include": [
    "src/main.ts",
    "src/game.ts",
    "src/playcanvas/**/*.ts",
    "src/vite-env.d.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
