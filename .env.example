# The Adventures of Lil Artie — Environment Variables Example
# Copy this file to .env and fill in your values.

# App
VITE_APP_TITLE="The Adventures of Lil Artie"
VITE_APP_VERSION="0.1.0"

# Debug mode (true | false)
VITE_DEBUG_MODE=false

# Physics engine path (Havok WASM)
VITE_HAVOK_WASM_PATH="/assets/havok/HavokPhysics.wasm"

# Asset CDN base URL (leave blank for local)
VITE_ASSET_BASE_URL=""

# Analytics (optional)
VITE_ANALYTICS_ID=""
