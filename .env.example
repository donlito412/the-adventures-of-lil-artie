# The Adventures of Lil Artie — Environment Variables Example
# Copy this file to .env and fill in your values.

# App
VITE_APP_TITLE="The Adventures of Lil Artie"
VITE_APP_VERSION="0.1.0"

# Debug mode (true | false)
VITE_DEBUG_MODE=false

# Asset CDN base URL (leave blank for local)
VITE_ASSET_BASE_URL=""

# PlayCanvas automation
# Keep the real token only in your local .env or shell environment. Never commit it.
PLAYCANVAS_PROJECT_ID="1533403"
PLAYCANVAS_SCENE_ID="2507920"
PLAYCANVAS_BRANCH_ID="ab416900-ea04-4eb1-9151-673660b4351f"
PLAYCANVAS_API_TOKEN=""

# Analytics (optional)
VITE_ANALYTICS_ID=""
